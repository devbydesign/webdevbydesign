---
import { getTestimonials } from "../data/testimonials";
import { pageHref } from "../data/site";

interface Props { featured?: string[]; }
const { featured = ["vicki-r", "john-l"] } = Astro.props;
const items = getTestimonials(featured);
---

<section class="testimonials" aria-labelledby="testimonials-heading">
  <div class="container">
    <div class="heading-row">
      <div>
        <p class="eyebrow">Client perspectives</p>
        <h2 id="testimonials-heading">Testimonials</h2>
      </div>
      <a href={pageHref("/testimonial/john-l/")}>Read client stories <span aria-hidden="true">→</span></a>
    </div>
    <div class="testimonial-grid">
      {items.map((item) => (
        <article>
          <div class="quote-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M5 7h6v6c0 3.2-1.7 5.4-5 6.5l-1-2.3c1.8-.7 2.8-1.7 3-3.2H5V7Zm10 0h6v6c0 3.2-1.7 5.4-5 6.5l-1-2.3c1.8-.7 2.8-1.7 3-3.2h-3V7Z"></path>
            </svg>
          </div>
          <blockquote><p>{item.excerpt}</p></blockquote>
          <footer>
            <strong>{item.name}</strong>
            <a href={pageHref(`/testimonial/${item.slug}/`)} aria-label={`Read the full testimonial from ${item.name}`}>Read more <span class="read-arrow" aria-hidden="true">→</span></a>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials { padding-block: var(--space-xl); color: white; background: linear-gradient(145deg, #363f96, var(--navy) 16%, #8693c4); }
  .heading-row { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.75rem; }
  h2 { margin: 0; color: white; }
  .eyebrow { color: #d5defe; }
  .heading-row > a { color: white; font-weight: 700; }
  .testimonial-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 3vw, 2.3rem); }
  article { position: relative; display: flex; min-height: 16rem; flex-direction: column; padding: clamp(1.4rem, 3vw, 2rem); overflow: hidden; color: var(--ink); background: white; border-radius: var(--radius); box-shadow: var(--shadow-lg); }
  .quote-mark { position: absolute; top: 1.35rem; right: 1.45rem; display: grid; width: 3.5rem; height: 3.5rem; place-items: center; color: #b8c7f4; opacity: 0.58; }
  .quote-mark svg { display: block; width: 2.35rem; height: 2.35rem; fill: currentColor; }
  blockquote { position: relative; margin: 0; padding-right: 3.9rem; }
  blockquote p { margin: 0; }
  footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  footer a { display: inline-flex; align-items: center; gap: 0.3rem; font-weight: 700; }
  .read-arrow { transition: transform 160ms ease; }
  footer a:hover .read-arrow { transform: translateX(3px); }
  @media (max-width: 42rem) {
    .heading-row { align-items: start; flex-direction: column; }
    .testimonial-grid { grid-template-columns: 1fr; }
    article { min-height: auto; }
  }
</style>
