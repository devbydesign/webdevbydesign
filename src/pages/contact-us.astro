---
import BaseLayout from "../layouts/BaseLayout.astro";
import TestimonialBand from "../components/TestimonialBand.astro";
import { emailHref, site } from "../data/site";
---

<BaseLayout title="Contact Us" description="Contact Dev By Design about your website project, maintenance, design, development, or testing needs.">
  <section class="contact section">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">Let’s talk</p>
        <h1>Contact Us</h1>
        <p class="lede">We would love to learn about your project or ongoing website maintenance needs.</p>
      </div>
      <div class="contact-card card">
        <span class="mail-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" width="42" height="42"><rect x="5" y="9" width="38" height="30" rx="4"></rect><path d="m7 13 17 14 17-14"></path></svg>
        </span>
        <h2>Send us an email</h2>
        <p>Tell us what you’re considering, where you need help, and any timing you already have in mind. We’ll be happy to discuss it with you.</p>
        <a class="email-link" href={emailHref()}>{site.email}</a>
        <a class="button" href={emailHref()}>Start an email <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  <TestimonialBand featured={["rebecca-b", "bryan-o"]} />
</BaseLayout>

<style>
  .contact { background: radial-gradient(circle at 15% 15%, #f2f5ff 0%, transparent 35%), var(--surface-soft); }
  .contact-grid { display: grid; grid-template-columns: minmax(18rem, 0.8fr) minmax(24rem, 1.2fr); align-items: center; gap: clamp(2rem, 9vw, 8rem); }
  .contact-card { padding: clamp(2rem, 6vw, 4rem); }
  .mail-icon { display: grid; width: 4.5rem; height: 4.5rem; margin-bottom: 1.5rem; place-items: center; color: white; background: var(--slate); border-radius: 1rem; }
  svg { fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 2.5; }
  .contact-card p { color: var(--ink-soft); }
  .email-link { display: block; width: fit-content; margin-block: 1.5rem; overflow-wrap: anywhere; font-size: clamp(1rem, 3.8vw, 1.35rem); font-weight: 800; }
  @media (max-width: 48rem) {
    .contact-grid { grid-template-columns: 1fr; }
    .contact-card { padding: 1.5rem; }
    .email-link { font-size: 0.9rem; }
  }
</style>
